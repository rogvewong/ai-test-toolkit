# =====================================================================
# 天枢·裁决 Docker 部署 — 环境变量示例
#
# 用法:
#   cp .env.docker.example .env.docker
#   编辑 .env.docker 填上你的 Claude API Key
#   docker compose --env-file .env.docker up -d
#
# 也可以不填 ANTHROPIC_API_KEY,启动后用 admin 账号去 /settings 走 OAuth
# 授权 — 两种方式选一种即可。
# =====================================================================

# 你的 Anthropic API Key (sk-ant-api03-...)
# 留空 = 启动后 admin 在 web 设置页授权
ANTHROPIC_API_KEY=

# 首位管理员账号 — 启动时自动建 (用户已存在则忽略,不会覆盖密码)
# 留空 = 不自动建,需手动跑 SQL 或调 API
AITK_ADMIN_USER=admin
AITK_ADMIN_PASSWORD=改成你自己的强密码
AITK_ADMIN_DISPLAY_NAME=管理员

# 监听端口 — 镜像内部固定 8084,这里改的是宿主机映射
HOST_PORT=8084
