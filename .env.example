# === Core ===
APP_ENV=development
LOG_LEVEL=INFO

# === LLM transport ===
# Toolkit talks to the LOCAL Claude Code CLI (`claude -p`), not the Anthropic API.
# Auth comes from your Claude Code login (subscription / token).
# Override only if `claude` is not on PATH:
# CLAUDE_BIN=/Users/you/.local/bin/claude
#
# The values below are kept for back-compat with code that reads settings.*
# but are no longer required and not used by the LLM client.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
MODEL_OPUS=claude-opus-4-7
MODEL_SONNET=claude-sonnet-4-6
MODEL_HAIKU=claude-haiku-4-5-20251001

# === Storage ===
DATABASE_URL=sqlite+aiosqlite:///./toolkit.db
# For production: postgresql+asyncpg://user:pass@host:5432/toolkit

# === Memory ===
MEMORY_BACKEND=sqlite
MEMORY_MAX_SESSION_TURNS=50
MEMORY_EMBEDDING_MODEL=voyage-3

# === Reports ===
REPORT_OUTPUT_DIR=./output/reports
EVIDENCE_OUTPUT_DIR=./output/evidence

# === Cost guardrails ===
MAX_TOKENS_PER_CALL=8000
DAILY_BUDGET_USD=50
